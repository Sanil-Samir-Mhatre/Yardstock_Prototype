# GEMINI_API_KEY: Required for Gemini Vision AI & Explainability API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT & Zero-Trust Auth Configuration
JWT_SECRET="yardstock-zero-trust-hmac-secret-2026"
RATE_LIMIT_MAX_REQ_PER_MIN="60"

# PostgreSQL + PostGIS & Redis (Used in Docker / FastAPI deployment)
DATABASE_URL="postgresql://yardstock:yardstock_pass@postgres-postgis:5432/yardstock_db"
REDIS_URL="redis://redis:6379/0"

# Commission & Escrow Settings
ESCROW_COMMISSION_RATE="0.065"
LOCATION_FUZZ_RADIUS_METERS="650"

